                                      + " /* fall-through */")
@@ -2179,11 +2179,11 @@ def emit_function(rom: bytes, bank: int, start: int,
             # the per-cycle code-speed charge.
             _code_n, _other = _block_master_terms(block_per_insn_ir.get(key, []))
             if _spd_const is not None:
-                src.append(f'    cpu->master_cycles += {_code_n * _spd_const + _other};')
+                src.append(f'    cpu->master_cycles += SNES_CPU_CLOCKS({_code_n * _spd_const + _other});')
             elif _other:
-                src.append(f'    cpu->master_cycles += {_code_n} * {_spd_expr} + {_other};')
+                src.append(f'    cpu->master_cycles += SNES_CPU_CLOCKS({_code_n} * {_spd_expr} + {_other});')
             else:
-                src.append(f'    cpu->master_cycles += {_code_n} * {_spd_expr};')
+                src.append(f'    cpu->master_cycles += SNES_CPU_CLOCKS({_code_n} * {_spd_expr});')
         for ln in block_lines[key]:
             # Inject a stack-auditor pop before any return so the shadow
             # stack stays balanced. An LLE yield unwind is NOT a return: the
diff --git a/runner/src/cpu_state.c b/runner/src/cpu_state.c
index 57fe6bc..c35247f 100644
--- a/runner/src/cpu_state.c
+++ b/runner/src/cpu_state.c
@@ -351,6 +351,8 @@ static inline void cpu_pace_cycles_word(uint16 addr) {
  * (interp_bridge.c bridge_region_speed) and the AOT paced accessors below
  * share this single C implementation so both tiers price transfers
  * identically. */
+uint32 g_snes_cpu_clock_q8 = 256u;
+
 uint32_t cpu_region_speed(uint32_t adr) {
     uint8_t bank = (uint8_t)(adr >> 16);
     uint16_t a = (uint16_t)adr;
diff --git a/runner/src/cpu_state.h b/runner/src/cpu_state.h
index f9b1e26..3efbe05 100644
--- a/runner/src/cpu_state.h
+++ b/runner/src/cpu_state.h
@@ -757,6 +757,15 @@ RecompReturn interp_tier_dispatch_bank_miss(CpuState *cpu, uint32 addr_pc24,
  * decay it into a value mistaken for a local NLR before the (bounded ≪ 2^30)
  * host stack unwinds. */
 #define RECOMP_RETURN_LLE_UNWIND_BASE 0x40000000
+
+/* Main-CPU clock scale, in 1/256ths of a master clock per charged clock:
+ * 256 (the default) is the console's speed. A lower value makes every
+ * 65816 instruction, compiled or interpreted, cost fewer master clocks while
+ * the beam, APU, DMA and coprocessors keep real time -- an overclock, which
+ * a title can offer to reduce in-game slowdown. Every CPU charge goes
+ * through SNES_CPU_CLOCKS; at 256 it is the unscaled value. */
+extern uint32 g_snes_cpu_clock_q8;
+#define SNES_CPU_CLOCKS(n)   (g_snes_cpu_clock_q8 == 256u ? (uint64)(n)                                : (((uint64)(n) * g_snes_cpu_clock_q8) >> 8))
 int interp_bridge_in_lle_scheduler(void);
 int interp_bridge_lle_master_deadline_reached(const CpuState *cpu);
 RecompReturn interp_bridge_lle_yield_unwind(CpuState *cpu, uint32 resume_pc24);
diff --git a/runner/src/snes/interp_bridge.c b/runner/src/snes/interp_bridge.c
index c1e48eb..9ef71f4 100644
--- a/runner/src/snes/interp_bridge.c
+++ b/runner/src/snes/interp_bridge.c
@@ -2471,7 +2471,7 @@ static int _interp_run_core(CpuState *cpu, uint32_t entry_pc24,
         {
             unsigned _internal = (unsigned)_cyc > s_interp_bus_cycles
                                ? (unsigned)_cyc - s_interp_bus_cycles : 0;
-            uint64_t _master = s_interp_bus_master + (uint64_t)_internal * 6u;
+            uint64_t _master = SNES_CPU_CLOCKS(s_interp_bus_master + (uint64_t)_internal * 6u);
             g_interp_bridge_steps++;
             cpu->cycles        += (uint64_t)_cyc;
             cpu->master_cycles += _master;
