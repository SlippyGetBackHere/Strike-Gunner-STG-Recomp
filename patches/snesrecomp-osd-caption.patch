From 0389a479d6cb027d96a090d365394f5e17f40f03 Mon Sep 17 00:00:00 2001
From: SlippyGetBackHere <343265862+SlippyGetBackHere@users.noreply.github.com>
Date: Sun, 18 Oct 2026 04:01:37 -0400
Subject: [PATCH] osd: a small bottom caption for a title's own notices

snes_osd_caption(msg, duration_ms, anchor, edge_margin) shows a caption
at the bottom of the frame, centred or against the right edge less a
margin (SNES_OSD_CAPTION_BOTTOM_CENTER / _RIGHT), separate from the
top-left toasts; snes_osd_caption_image() hands the panel to the host,
and ComposeOsd draws it. It uses a new small proportional font (capitals
6 pixels tall, most glyphs 4 wide; drawn for snesrecomp, CC0) on a
translucent panel. Text wider than the frame wraps at a space onto a
second line; past that it is cut with "...". A game's "now playing"
display uses it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runner/src/desktop/host_main.c |  12 ++
 runner/src/snes_osd.c          | 276 ++++++++++++++++++++++++++++++++-
 runner/src/snes_osd.h          |  17 ++
 3 files changed, 304 insertions(+), 1 deletion(-)

diff --git a/runner/src/desktop/host_main.c b/runner/src/desktop/host_main.c
index f22354c..ba443e9 100644
--- a/runner/src/desktop/host_main.c
+++ b/runner/src/desktop/host_main.c
@@ -1200,6 +1200,18 @@ static void ComposeOsd(uint8 *dst, int pitch, int dst_w, int dst_h, int scale_di
     snes_ovl_blit_panel_rect(dst, pitch, dst_w, dst_h, px, w, h,
                              dst_w - bw - 4 / scale_div, (dst_h - bh) / 2, bw, bh);
   }
+  /* A title's caption sits at the bottom, centred or against the right edge
+   * less its margin (given in 1x frame pixels). */
+  int anchor = 0, margin = 0;
+  if (snes_osd_caption_image(&px, &w, &h, &anchor, &margin) && px && w > 0 && h > 0) {
+    const int bw = w / scale_div, bh = h / scale_div;
+    const int unit = dst_w / 256 > 0 ? dst_w / 256 : 1;
+    const int x = anchor == SNES_OSD_CAPTION_BOTTOM_RIGHT
+        ? dst_w - bw - (margin + 2) * unit
+        : (dst_w - bw) / 2;
+    snes_ovl_blit_panel_rect(dst, pitch, dst_w, dst_h, px, w, h,
+                             x, dst_h - bh - 4 * unit, bw, bh);
+  }
   snes_osd_present_done();
 }
 
