From 769207d08127daf41a27441c497dcae1f6a3662b Mon Sep 17 00:00:00 2001
From: SlippyGetBackHere <343265862+SlippyGetBackHere@users.noreply.github.com>
Date: Thu, 15 Oct 2026 20:14:07 -0400
Subject: [PATCH] host: clear the rewind hotkey before opening the filmstrip

The clear after the open block was skipped by its continue, so the flag
stayed set and the strip reopened on the next pass: a commit or cancel
from an F12-opened strip landed straight back in a fresh one. The pad
gesture is edge-detected and was unaffected.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runner/src/desktop/host_main.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/runner/src/desktop/host_main.c b/runner/src/desktop/host_main.c
index e6cf1f3..f22354c 100644
--- a/runner/src/desktop/host_main.c
+++ b/runner/src/desktop/host_main.c
@@ -4113,6 +4113,11 @@ error_reading:;
     g_open_launcher_hotkey = 0;
     if ((g_rewind_hotkey || PadGesturePressed(&g_rewind_gesture)) && !snes_rewind_is_open() &&
         !snes_savestate_menu_is_open()) {
+      /* Consume the hotkey before opening. The `continue` below skips the
+       * clear after this block, so a hotkey still set there reopened the
+       * strip on the next pass: every commit or cancel landed straight back
+       * in a fresh strip, and the player could never leave it. */
+      g_rewind_hotkey = 0;
       /* Refused during netplay by snes_rewind_open() itself: one machine
        * cannot move its own clock backwards while a peer is watching. */
       if (snes_rewind_open()) {
-- 
